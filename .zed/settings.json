{
  "format_on_save": "on",
  "prettier": { "allowed": false },
  "formatter": [{ "language_server": { "name": "oxfmt" } }],
  "languages": {
    "JavaScript": {
      "language_servers": ["...", "!eslint", "oxlint", "oxfmt"],
      "formatter": [
        { "code_action": "source.fixAll.oxc" },
        { "language_server": { "name": "oxfmt" } }
      ]
    },
    "TypeScript": {
      "language_servers": ["...", "!eslint", "oxlint", "oxfmt"],
      "formatter": [
        { "code_action": "source.fixAll.oxc" },
        { "language_server": { "name": "oxfmt" } }
      ]
    },
    "TSX": {
      "language_servers": ["...", "!eslint", "oxlint", "oxfmt"],
      "formatter": [
        { "code_action": "source.fixAll.oxc" },
        { "language_server": { "name": "oxfmt" } }
      ]
    },
    "HTML": {
      "language_servers": ["...", "!eslint", "oxfmt"]
    },
    "Markdown": {
      "language_servers": ["...", "!eslint", "oxfmt"]
    },
    "JSON": {
      "language_servers": ["...", "!eslint", "oxfmt"]
    },
    "JSONC": {
      "language_servers": ["...", "!eslint", "oxfmt"]
    },
    "YAML": {
      "language_servers": ["...", "!eslint", "oxfmt"]
    },
    "CSS": {
      "language_servers": ["...", "!eslint", "oxfmt"]
    }
  }
}
