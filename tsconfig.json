{
  "compilerOptions": {
    "target": "ES2021",
    "rootDir": ".",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "paths": {
      "#/*": ["./src/*"]
    },
    "types": ["bun-types"],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "exclude": ["node_modules", ".agents", "temp"]
}
